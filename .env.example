# Ollama Configuration for Classroom Hub Model

# OLLAMA_HOST: Where Bulela connects to Ollama (default: 127.0.0.1 for same-machine)
# For Classroom Hub: Set Windows env var OLLAMA_HOST=0.0.0.0 so Ollama listens to network
# Bulela connects to Ollama at 127.0.0.1 (localhost) since they're on same laptop
OLLAMA_HOST="127.0.0.1"

# OLLAMA_PORT: The port where Ollama is running (default: 11434)
OLLAMA_PORT="11434"

# OLLAMA_URL: Full URL for Ollama API (overrides HOST+PORT if set)
OLLAMA_URL="http://127.0.0.1:11434"

# OLLAMA_MODEL: The Ollama model to use (default: gemma4:latest)
OLLAMA_MODEL="gemma4:latest"

# DEMO_MODE: Enable demo mode for hackathon presentations (default: false)
# When enabled, the app returns pre-canned responses without requiring Ollama
DEMO_MODE="false"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
